{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublicReadLiveTV",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::greentv-s3/LiveTV/*"
    },
    {
      "Sid": "PublicReadVideos",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::greentv-s3/videos/*"
    },
    {
      "Sid": "PublicReadThumbnails",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::greentv-s3/thumbnails/*"
    },
    {
      "Sid": "PublicReadVideoThumbnails",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::greentv-s3/Thumbnail/videos/*"
    },
    {
      "Sid": "PublicReadArticles",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::greentv-s3/articles/*"
    },
    {
      "Sid": "PublicReadArticleThumbnails",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::greentv-s3/Thumbnail/articles/*"
    },
    {
      "Sid": "PublicReadPodcasts",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::greentv-s3/podcasts/*"
    },
    {
      "Sid": "PublicReadPodcastLegacy",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::greentv-s3/podcast/*"
    },
    {
      "Sid": "PublicReadPodcastThumbnails",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::greentv-s3/Thumbnail/podcast/*"
    }
  ]
}
