  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Auto-login if no access token exists",
          "if (!pm.environment.get('accessToken') && !pm.collectionVariables.get('accessToken')) {",
          "  console.log('No access token found, will need to login first');",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Global test: Response time should be reasonable",
          "pm.test('Response time under 5s', function() {",
          "  pm.expect(pm.response.responseTime).to.be.below(5000);",
          "});",
          "",
          "// Log errors for debugging",
          "if (pm.response.code >= 400) {",
          "  console.log('Error response:', pm.response.json());",
          "}"
        ]
      }
    }
  ],
