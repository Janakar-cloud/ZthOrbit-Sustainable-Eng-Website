PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/zthorbit
JWT_SECRET=replace-with-strong-secret
JWT_REFRESH_SECRET=replace-with-strong-refresh-secret

# Development (local):
# APP_URL=http://localhost:3000
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Production (EC2 13.205.72.30):
APP_URL=https://www.thegreentv.com
# Alternative:
# APP_URL=http://13.205.72.30
CORS_ORIGINS=https://www.thegreentv.com,http://13.205.72.30,https://13.205.72.30,http://13.205.72.30:3000

S3_REGION=ap-south-1
S3_BUCKET=your-s3-bucket
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
SEED_DEFAULT_PASSWORD=ChangeMe123!
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=greentvsupport@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="Green TV Support <greentvsupport@gmail.com>"

# CloudFront signed cookie settings for authenticated HLS playback
CF_STREAM_DOMAIN=stream.thegreentv.com
# Alternative (only if streaming is served directly from IP host and cookies are not domain-scoped)
# CF_STREAM_DOMAIN=13.205.72.30
CF_KEY_PAIR_ID=KXXXXXXXXXXXX
CF_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_CONTENT\n-----END PRIVATE KEY-----"
CF_COOKIE_TTL_SECONDS=600
# Use apex domain so cookies can be sent to stream.thegreentv.com
CF_COOKIE_DOMAIN=.thegreentv.com
# For raw IP host setups, cookie domain is usually left empty:
# CF_COOKIE_DOMAIN=
