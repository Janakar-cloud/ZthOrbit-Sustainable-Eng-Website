PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/zthorbit
JWT_SECRET=replace-with-strong-secret
JWT_REFRESH_SECRET=replace-with-strong-refresh-secret

# Development (local):
# APP_URL=http://localhost:3000
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Production (EC2 13.205.72.30):
APP_URL=https://www.thegreentv.com
DASHBOARD_URL=http://13.205.72.30:3039
# Alternative:
# APP_URL=http://13.205.72.30
CORS_ORIGINS=https://www.thegreentv.com,https://dashboard.thegreentv.com,http://13.205.72.30,https://13.205.72.30,http://13.205.72.30:3000,http://13.205.72.30:3039

S3_REGION=ap-south-1
S3_BUCKET=your-s3-bucket
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
SEED_DEFAULT_PASSWORD=ChangeMe123!
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=greentvsupport@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="Green TV Support <greentvsupport@gmail.com>"

# Live streaming access mode
# direct: use Nginx RTMP/HLS without CloudFront signed cookies
# cloudfront: enable signed cookies for CloudFront distributions
# s3_playlist: play videos from S3 bucket folder in a loop (recommended for VOD)
LIVE_ACCESS_MODE=s3_playlist

# S3 folder path for playlist mode (videos will be played in alphabetical order and loop)
LIVE_S3_FOLDER=LiveTV

# CloudFront signed cookie settings (only when LIVE_ACCESS_MODE=cloudfront)
# CF_STREAM_DOMAIN=stream.thegreentv.com
# CF_KEY_PAIR_ID=KXXXXXXXXXXXX
# CF_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_CONTENT\n-----END PRIVATE KEY-----"
# CF_COOKIE_TTL_SECONDS=600
# CF_COOKIE_DOMAIN=.thegreentv.com
